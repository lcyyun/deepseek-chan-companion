{
  "manifest_version": 3,
  "name": "小鲸 · 一起看",
  "version": "0.1.0",
  "description": "把你主动分享的页面交给本机 DeepSeek-chan，一起浏览、搜索和聊天。",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:39181/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "和小鲸一起看这页"}
}
